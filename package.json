{
  "name": "atlas-discord",
  "version": "0.1.0",
  "private": true,
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.25.12": true
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "dev:bot": "tsx watch src/bot/index.ts",
    "build": "prisma generate && next build",
    "build:bot": "node scripts/build-bot.mjs",
    "package:bot": "npm run build:bot && node scripts/package-bot.mjs",
    "start": "tsx server.ts",
    "bot": "tsx src/bot/index.ts",
    "check": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "1.1.15",
    "discord.js": "14.27.0",
    "dotenv": "17.2.3",
    "ffmpeg-static": "5.3.0",
    "ioredis": "5.8.2",
    "lucide-react": "0.468.0",
    "next": "16.4.0",
    "opusscript": "0.0.8",
    "prisma": "6.19.3",
    "quickjs-emscripten": "0.32.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "3.5.1",
    "sharp": "0.35.5",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "tsx": "4.20.6",
    "youtubei.js": "18.1.0",
    "zod": "3.25.76"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.25.12",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
