NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://atlas:CHANGE_ME@localhost:5432/atlas?schema=public
REDIS_URL=redis://localhost:6379
# Discord Developer Portal > OAuth2 > Redirects : APP_URL/api/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
OWNER_DISCORD_ID=
# 64 hexadecimal characters (32 random bytes), generated during installation.
ENCRYPTION_KEY=
# Enable privileged intents in Discord only when approved / available.
DISCORD_MEMBERS_INTENT=true
DISCORD_MESSAGE_CONTENT_INTENT=true
DISCORD_PRESENCE_INTENT=false
# Optional assistant provider (OpenAI-compatible). Never stored in browser.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
# Proxy domain for docker-compose.prod.yml
DOMAIN=
ACME_EMAIL=
POSTGRES_PASSWORD=CHANGE_ME
